ENV/

# Data Files (Keep large data files out of version control)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/reference/*
!data/reference/.gitkeep
data/master/*
!data/master/.gitkeep

# Models and artifacts
models/*.pkl
models/*.joblib
models/*.json
models/*.onnx
ML/ml_engineer/artifacts/*.joblib

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDE and OS
.DS_Store
.vscode/
.idea/

# Logs
logs/
*.log

# CatBoost training logs
catboost_info/

# Local tooling and large generated models
.claude/
catboost_info/
ML/ml_engineer/artifacts/hybrid/*.joblib

# Phase 2 - Deep Learning data and generated artifacts
DL/data/raw/**
DL/data/interim/**
DL/data/processed/**
DL/data/reference/**
DL/models/**
DL/.venv/
DL/.env
DL/.env.*
DL/.pytest_cache/

# Phase 2 - Supplementary staging raw data (Exceeds GitHub limits e.g. portcalls.csv 198MB)
DL/data/staging/supplementary_acquisition/raw/**
!DL/data/staging/supplementary_acquisition/raw/.gitkeep

# Phase 2 - Model-ready Parquet datasets tracked via Git LFS (.gitattributes)
# Processed parquets (<100MB each, total ~165MB) are managed by Git LFS.
!DL/data/staging/supplementary_acquisition/processed/**/*.parquet
!DL/data/staging/supplementary_acquisition/processed/**/.gitkeep

# Preserve all manifests, schemas, crosswalks, CSVs, and markdown documentation
!DL/data/staging/supplementary_acquisition/**/*.md
!DL/data/staging/supplementary_acquisition/**/*.csv
!DL/data/staging/supplementary_acquisition/**/*.json

